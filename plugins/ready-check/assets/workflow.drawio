<mxfile><diagram id="workflow" name="Workflow"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Ready Check workflow" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="420" height="40" as="geometry"/></mxCell><mxCell id="s1" value="Task finished in the chat&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;hook offers a check, asks first&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="200" height="70" as="geometry"/></mxCell><mxCell id="s2" value="Requirements RC-001…&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;chat, file or recorded prompts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="200" height="70" as="geometry"/></mxCell><mxCell id="s3" value="Static checks&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;profile linters, task lines only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="200" height="70" as="geometry"/></mxCell><mxCell id="d1" value="Static pass?" style="rhombus;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFF6E0;strokeColor=#E8C36A;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="50" y="430" width="180" height="90" as="geometry"/></mxCell><mxCell id="s4" value="Review&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;RCs, checklist, security, your rules&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="200" height="70" as="geometry"/></mxCell><mxCell id="d2" value="Review pass?" style="rhombus;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFF6E0;strokeColor=#E8C36A;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="50" y="680" width="180" height="90" as="geometry"/></mxCell><mxCell id="fix" value="Fix round&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;here, subagent or you; reruns only what changed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFF0E5;strokeColor=#F0B48A;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="300" y="440" width="200" height="70" as="geometry"/></mxCell><mxCell id="q1" value="QA plan&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;risks, test techniques, oracles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="200" height="70" as="geometry"/></mxCell><mxCell id="q2" value="You approve the plan&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;visible or background browser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFF0E5;strokeColor=#F0B48A;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="200" height="70" as="geometry"/></mxCell><mxCell id="q3" value="Browser QA&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Playwright, axe, short exploration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="200" height="70" as="geometry"/></mxCell><mxCell id="d3" value="QA pass?" style="rhombus;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFF6E0;strokeColor=#E8C36A;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="570" y="430" width="180" height="90" as="geometry"/></mxCell><mxCell id="v1" value="READY TO PUSH&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;report with every round&lt;/font&gt;" style="round